# ============================================================
# Smart-Check Automation — Variables de entorno
# Copiar este archivo como .env y completar los valores reales.
# NUNCA commitear el .env con credenciales reales.
# ============================================================

# Cadena de conexión a PostgreSQL.
# En producción: usar Supabase PostgreSQL 16 (puerto 5432).
# Formato: postgres://user:password@host:5432/dbname?sslmode=require
# En Docker local: postgres://user:password@db:5432/dbname?sslmode=disable
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Orígenes explícitos del panel, separados por coma; nunca usar * con cookies.
FRONTEND_ORIGINS=https://panel.example.invalid

# Autenticación de nodos: el dispositivo se registra con POST
# /api/v1/registration-requests, un Supervisor/Admin aprueba, y desde entonces usa
# Authorization: Bearer <secret> en ping, lotes e inicio de lote.

# Puerto en que escucha el servidor HTTP (default: 8080)
PORT=8080

# ============================================================
# Telemetría de dispositivos (Raspberry Pi)
# ============================================================
# Intervalo del reaper que detecta dispositivos offline (default: 5s)
# DISPOSITIVO_REAPER_INTERVAL=5s
# Umbral de inactividad para considerar un dispositivo offline (default: 90s)
# DISPOSITIVO_OFFLINE_THRESHOLD=90s
# Timeout del push de renombre desde el panel al endpoint local de la Raspberry
# (default: 10s). Si la Pi cuelga más allá de este tiempo, el rename se cancela
# sin tocar la DB para evitar inconsistencia con el polling posterior. Subirlo
# sólo si las Raspberry están detrás de túneles con latencia alta.
# DISPOSITIVO_RENAME_PUSH_TIMEOUT=10s

# SCA-400: URL del sidecar predictor XGBoost (cmd/predictor_svc).
# Si no está configurado, el optimizador cae a modo degradado: las
# decisiones se marcan como skipped y el horno sigue con el último
# setpoint aplicado.
# PREDICTOR_URL=http://localhost:8090

# Token opcional Bearer para autenticar contra el sidecar. Si está vacío, no
# se envía header Authorization. Útil cuando el sidecar corre detrás de un
# proxy que requiere auth.
# PREDICTOR_AUTH_TOKEN=

# Quién aplica las consignas del MPC: "pi" (default) o "backend".
# - pi: la Pi ENTRADA es la única que escribe el PLC real; el backend usa el
#   stub interno para auditar/actualizar estado.
# - backend: sólo laboratorio; el backend usa el mismo stub, no escribe PLC.
# CONTROL_ACTUADOR=pi

# Umbral mínimo de confianza promedio del detector (0..1) para proponer
# cambios. Por debajo, la decisión se audita como confianza_baja. Default 0.5.
# MPC_CONFIANZA_MIN=0.5

# Tiempo máximo de precalentamiento en AUTOMATICO (segundos). Si el horno no
# llega a la temperatura objetivo ± tolerancia en ese plazo, el loop aborta y
# deja la decisión auditada como precalentamiento_timeout. Default 1800.
# MPC_PRECALENTAMIENTO_TIMEOUT_SEGUNDOS=1800

# Cada cuántos segundos el loop revisa la temperatura durante el
# precalentamiento. Default 15. Bajarlo acelera demos/E2E pero aumenta las
# lecturas a la base; no afecta la cadencia de adaptación (ventana del lote).
# MPC_PREHEAT_POLL_SEGUNDOS=15

# Permite que AUTOMATICO opere con el predictor placeholder cuando todavía no
# hay modelo XGBoost entrenado. Sólo para demo/tesis; en producción dejarlo en
# false (el loop se bloquea con modelo_no_entrenado).
# MPC_PERMITIR_PLACEHOLDER=false

# ============================================================
# Ciclo de lote por sector
# ============================================================
# Inactividad mínima (segundos, admite decimales) que el backend exige antes
# de aceptar un cierre de lote: si el sector estuvo activo hace menos de este
# umbral, POST /api/v1/lotes/{id}/cierre responde 409 sector_activo y la Pi
# reintenta. Default 0 = no enforce (permisivo).
# LOTE_CIERRE_MIN_INACTIVIDAD_SEGUNDOS=30

# ============================================================
# Auth — Google OAuth 2.0 + JWT de sesión
# ============================================================

# JWT_SECRET: clave de firma del token interno.
# Generar con: openssl rand -hex 32
# Mínimo 32 caracteres. NUNCA usar la misma en desarrollo y producción.
JWT_SECRET=your-jwt-signing-secret-minimum-32-characters

# GOOGLE_CLIENT_ID: Client ID de tu proyecto en Google Cloud Console.
# Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============================================================
# Solo para docker-compose local (servicio `db`)
# ============================================================
# docker-compose.yml inicializa el contenedor `db` con POSTGRES_USER /
# POSTGRES_PASSWORD / POSTGRES_DB y usa las mismas para su healthcheck. El
# servicio `app` monta este archivo con `env_file: .env`, así que estas variables
# son requeridas para `docker compose up` en local. No se usan en Render/Supabase.
# POSTGRES_USER=smartcheck
# POSTGRES_PASSWORD=smartcheck
# POSTGRES_DB=smart_check

# ============================================================
# Solo para tests de integración (no usar la DB de producción)
# ============================================================
# TEST_DATABASE_URL=postgres://user:password@localhost:5432/smart_check_test?sslmode=disable
